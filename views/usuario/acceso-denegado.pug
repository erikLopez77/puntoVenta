doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Click-comanda | #{pagina}
    link(rel="stylesheet", href="/css/app.css")
  body.min-h-screen.bg-gray-50
    .min-h-screen.flex.items-center.justify-center.bg-gray-100
        .bg-white.p-8.rounded-lg.shadow-lg.text-center.max-w-md.w-full
            // Icono de advertencia
            .flex.justify-center
                svg(xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z")
            
            // Título
            h2.text-2xl.font-bold.text-gray-800.mt-4 Acceso denegado
            
            // Mensaje
            p.text-gray-600.mt-2 No tienes permisos para acceder a esta página. Por favor, inicia sesión con una cuenta válida.
            
            // Botón para volver al inicio de sesión
            .mt-6
                a(href="/usuario/iniciar-sesion" class="inline-block bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600 transition duration-300") Volver al inicio de sesión