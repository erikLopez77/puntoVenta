extends ../layout/head

block contenido
    div(class="min-h-screen bg-gray-100 flex flex-col items-center justify-center p-4")
        div(class="bg-white rounded-lg shadow-lg p-8 max-w-2xl w-full")
            -// Título del platillo
            h2(class="text-3xl font-extrabold text-blue-700 mb-4")= platillo.nombre

            -// Descripción del platillo
            p(class="text-gray-700 text-lg mb-6")= platillo.descripcion

            -// Precio del platillo
            p(class="text-blue-600 font-semibold text-xl mb-8") Precio: $#{platillo.precio}

            -// Formulario para seleccionar cantidad y agregar indicaciones
            form(method="POST" class="space-y-6" id="addForm")
                -// Campo oculto para enviar el ID del platillo
                input(type="hidden", name="id", value=platillo.id)

                -// Selector de cantidad (1 a 30)
                div(class="space-y-2")
                    label(for="cantidad" class="block text-gray-700 font-medium") Cantidad **
                    select(id="cantidad" name="cantidad" class="w-full p-2 border border-blue-500 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500")
                        - for (let i = 1; i <= 30; i++)
                            option(value=i)= i

                -// Input de texto para indicaciones adicionales (opcional)
                div(class="space-y-2")
                    label(for="indicaciones" class="block text-gray-700 font-medium") Indicaciones adicionales (opcional)
                    textarea(id="indicaciones" name="indicaciones" class="w-full p-2 border border-blue-500 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" rows="3")

                -// Botones de acción
                div(class="flex flex-col md:flex-row justify-between gap-4 mt-8")
                    // Botón para regresar
                    a(
                        href="/menu-general" 
                        class="w-full md:w-auto bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 hover:shadow-lg flex items-center justify-center gap-2"
                    )
                        svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
                        span Regresar

                    // Botón para hacer el pedido
                    button(
                        type="submit" 
                        class="w-full md:w-auto bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 hover:shadow-lg flex items-center justify-center gap-2"
                    )
                        svg(xmlns="http://www.w3.org/2000/svg", class="h-6 w-6 mr-2", fill="none", viewBox="0 0 24 24", stroke="currentColor")
                            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01")
                        span Agregar a la comanda
block scripts
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/js/agregaItem.js")
    script(src="/js/cerrarSesion.js")
    