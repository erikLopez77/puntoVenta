extends ../layout/headAdmin

block contenido
    div(class="menu-container bg-white p-6 space-y-8")
        include ../barra-buscar-admin
        div(class="space-y-4 ml-6")
            // Título de la categoría con margen inferior
            h2.text-2xl.font-extrabold.text-gray-800.border-b-2.border-blue-500.pb-1.mb-8= pagina
            
            // Contenedor de platillos con espaciado entre elementos
            div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6")
                each resultado in resultados
                    // Tarjeta de platillo
                    div(class="menu-item bg-blue-100 border border-blue-600 rounded-lg shadow-lg p-4")
                        h2.text-xl.font-bold.text-blue-700= resultado.nombre
                        p.text-gray-700= resultado.descripcion
                        p.price.text-blue-600.font-semibold Precio: $#{resultado.precio}
                        -// Contenedor para los botones (flexbox para alinearlos horizontalmente)
                        div(class="flex space-x-4 mt-4")
                            -// Botón "Editar"
                            div.flex-1
                                form(action=`/usuario/edita-platillo/${resultado.id}`, method="GET", class="flex-1")
                                    button(type="submit", class="w-full bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded") Editar
                            div.flex-1
                                -// Botón "Eliminar"
                                form(action="/usuario/elimina-platillo", method="POST", class="formDelete")
                                    input(type="hidden", name="id", value=resultado.id)
                                    button(type="submit", class="w-full bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded") Eliminar

                // Mensaje si no hay resultados
                if !resultados.length
                    div(class="col-span-full menu-item bg-blue-100 border border-blue-600 rounded-lg shadow-lg p-4")
                        h2.text-l.font-bold.text-blue-700 No se encontraron coincidencias

            // Botones de acción
            div(class="flex justify-between mt-10")
                // Botón para regresar
                a(href="/usuario/vista-menu" class="bg-gray-500 hover:bg-gray-700 text-white font-bold mt-10 py-2 px-4 rounded-lg transition duration-300") Regresar

block scripts 
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/js/cerrarSesion.js")

