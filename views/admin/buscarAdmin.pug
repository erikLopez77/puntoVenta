extends ../layout/headAdmin

block contenido
    div(class="menu-container bg-white p-6 space-y-8")
        include ../barra-buscar-admin
        div(class="space-y-4 ml-6")
            // Título de la categoría con margen inferior
            h2.text-2xl.font-extrabold.text-gray-800.border-b-2.border-blue-500.pb-1.mb-8= pagina
            
            // Contenedor de platillos con espaciado entre elementos
            div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6")
                each resultado in resultados
                    // Tarjeta de platillo
                    div(class="menu-item bg-blue-100 border border-blue-600 rounded-lg shadow-lg p-4")
                        h2.text-xl.font-bold.text-blue-700= resultado.nombre
                        p.text-gray-700= resultado.descripcion
                        p.price.text-blue-600.font-semibold Precio: $#{resultado.precio}
                        -// Contenedor para los botones (flexbox para alinearlos horizontalmente)
                        div(class="flex space-x-4 mt-4")
                            -// Botón "Editar"
                            div.flex-1
                                form(action=`/usuario/edita-platillo/${resultado.id}`, method="GET", class="flex-1")
                                    button(type="submit", class="w-full bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded") Editar
                            div.flex-1
                                -// Botón "Eliminar"
                                form(action="/usuario/elimina-platillo", method="POST", onsubmit="return confirmarEliminacion(event)" class="formDelete")
                                    input(type="hidden", name="id", value=resultado.id)
                                    button(type="submit", class="w-full bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded") Eliminar

                // Mensaje si no hay resultados
                if !resultados.length
                    div(class="col-span-full menu-item bg-blue-100 border border-blue-600 rounded-lg shadow-lg p-4")
                        h2.text-l.font-bold.text-blue-700 No se encontraron coincidencias

            // Botones de acción
            div(class="flex flex-col md:flex-row justify-between gap-4 mt-8")
                // Botón para regresar
                a(href="/usuario/vista-menu" class="w-full md:w-auto bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-6 rounded-lg transition-all duration-300 hover:shadow-lg flex items-center justify-center gap-2")
                    svg(xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
                    span Regresar

block scripts 
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src="/js/cerrarSesion.js")
    script.
            // Función para confirmar la eliminación de una orden
        function confirmarEliminacion(event) {
            event.preventDefault(); // Evita que el formulario se envíe automáticamente
            const form = event.target;

            Swal.fire({
                title: '¿Eliminar platillo?',
                text: "¡No podrás revertir esto!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
                    const respuesta = await fetch('/usuario/elimina-platillo', {
                        method: 'POST',
                        headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                        },
                        //body: new FormData(btnEnviaOrden), // Enviar los datos del formulario
                        body: JSON.stringify({ id: document.querySelector('input[name="id"]').value })
                    })
                    const solicitud = await respuesta.json();
                    if (respuesta.ok && solicitud.success) {
                        await Swal.fire('¡Eliminado!', solicitud.message, 'success');
                       window.location.reload(); 
                    } else {
                        await Swal.fire('¡Error!', solicitud.message, 'error');
                        window.location.reload(); // recarga
                    }
                }
            });
        }


