div(class="flex justify-end")
    form(action="/usuario/buscar", method="GET", class="w-1/4")
        div(class="relative")
            input(
                type="text",
                name="q",
                placeholder="Buscar platillos...",
                class="w-full p-2 pl-10 border border-gray-300 rounded-lg bg-blue-50 text-gray-700 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            )
            // Ícono de lupa dentro del campo de búsqueda
            div(class="absolute inset-y-0 left-0 flex items-center pl-3")
                svg(xmlns="http://www.w3.org/2000/svg", class="h-5 w-5 text-gray-500", fill="none", viewBox="0 0 24 24", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")