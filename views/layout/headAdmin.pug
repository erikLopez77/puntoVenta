doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Click-comanda | #{pagina}
    link(rel="icon" href="/favicon.svg" type="image/svg+xml")
    link(rel="stylesheet", href="/css/app.css")
    meta(name="csrf-token" content=csrfToken)
    script.
        function toggleSidebar() {
          document.getElementById('leftSidebar').classList.toggle('hidden');
        }
    block styles
  body.min-h-screen.bg-gray-50
    // Header superior con el botón de menú (hamburguesa)
    header(class="flex justify-between items-center p-4 bg-white shadow")
      // Botón de la izquierda para mostrar/ocultar el sidebar
      button(type="button", onclick="toggleSidebar()", class="p-2 focus:outline-none") 
        // Ícono de hamburguesa (tres líneas)
        svg(xmlns="http://www.w3.org/2000/svg", class="h-8 w-8 text-gray-700", fill="none", viewBox="0 0 24 24", stroke="currentColor")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M4 6h16M4 12h16M4 18h16")
      h1(class="text-3xl font-bold mb-3") Click-comanda
      // Puedes dejar el lado derecho vacío o agregar algún otro ícono si lo deseas
      div
    //- Barra de navegación inferior con variación de azul
    nav(class="bg-blue-600 text-white")
      //– Primera fila de navegación (como ya la tenías)
      ul(class="flex justify-around p-2")
        li: a(href="/usuario/vista-menu", class="hover:underline text-xl") Platillos en el menú
        li: a(href="/usuario/ordenes-confirmadas-cocina", class="hover:underline text-xl") Ordenes confirmadas en cocina

      //– Segunda fila: filtros con variación de azul
      ul(class="flex justify-around items-center bg-blue-500 p-3")
        li(class="bg-blue-500 px-4 py-2 rounded-full")
          a(href="/usuario/vista-menu", class="text-white") Todos los platillos
        li(class="bg-blue-500 px-4 py-2 rounded-full")
          a(href="/usuario/desayunos-administrador", class="text-white") Desayunos
        li(class="bg-blue-500 px-4 py-2 rounded-full")
          a(href="/usuario/sopas-administrador", class="text-white") Sopas y pastas
        li(class="bg-blue-500 px-4 py-2 rounded-full")
          a(href="/usuario/plato-fuerte-administrador", class="text-white") Plato fuerte
        li(class="bg-blue-500 px-4 py-2 rounded-full")
          a(href="/usuario/postres-administrador", class="text-white") Postres
        li(class="bg-blue-500 px-4 py-2 rounded-full")
          a(href="/usuario/bebidas-administrador", class="text-white") Bebidas


    // Contenedor principal con el sidebar a la izquierda y el contenido principal
    main(class="flex")
      // Sidebar (ahora ubicado en el lado izquierdo)
      aside#leftSidebar(class="w-64 bg-gray-800 text-white p-4 hidden")
        h2(class="text-xl mb-4") Click-comanda
        ul
          li: a(href="/usuario/guia-administrador", class="block py-2 hover:bg-gray-700") Guía de usuario
          li: a(href="#",id="frmC", class="block py-2 hover:bg-gray-700") Cerrar sesión

      // Bloque para el contenido principal
      section(class="flex-1 p-4")
        block contenido

    block scripts
                
