doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Click-comanda | #{pagina}
    link(rel="stylesheet", href="/css/app.css")
    script.
        function toggleSidebar() {
          document.getElementById('leftSidebar').classList.toggle('hidden');
        }
    block styles
  body.min-h-screen.bg-gray-50
    // Header superior con el botón de menú (hamburguesa)
    header(class="flex justify-between items-center p-4 bg-white shadow")
      // Botón de la izquierda para mostrar/ocultar el sidebar
      button(type="button", onclick="toggleSidebar()", class="p-2 focus:outline-none")
        // Ícono de hamburguesa (tres líneas)
        svg(xmlns="http://www.w3.org/2000/svg", class="h-8 w-8 text-gray-700", fill="none", viewBox="0 0 24 24", stroke="currentColor")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M4 6h16M4 12h16M4 18h16")
      h1(class="text-3xl font-bold mb-3") Click-comanda
      // Puedes dejar el lado derecho vacío o agregar algún otro ícono si lo deseas
      div

    // Barra de navegación debajo del header
    nav(class="bg-blue-600 text-white p-1 sm:p-2")
      ul(class="flex flex-col items-center sm:flex-row justify-around text-xs sm:text-base")
        li: a(href="/menu-general", class="hover:underline text-xl text-center sm:text-center") Menú general
        li: a(href="/desayunos", class="hover:underline text-xl text-center sm:text-center") Desayunos
        li: a(href="/sopas-pastas", class="hover:underline text-xl text-center sm:text-center") Sopas y pastas
        li: a(href="/plato-fuerte", class="hover:underline text-xl text-center sm:text-center") Plato fuerte
        li: a(href="/postres", class="hover:underline text-xl text-center sm:text-center") Postres
        li: a(href="/bebidas", class="hover:underline text-xl text-center sm:text-center") Bebidas

    // Contenedor principal con el sidebar a la izquierda y el contenido principal
    main(class="flex")
      // Sidebar (ahora ubicado en el lado izquierdo)
      aside#leftSidebar(class="w-64 bg-gray-800 text-white p-4 hidden")
        h2(class="text-xl mb-4") Click-comanda
        // Botón con ícono de "carro"
        a(href="/comanda", class="w-full flex items-center p-2 bg-blue-500 hover:bg-blue-400 rounded mb-4")
          // Ícono de carro (shopping cart) – utiliza un SVG de ejemplo
          svg(xmlns="http://www.w3.org/2000/svg", class="h-6 w-6 mr-2", fill="none", viewBox="0 0 24 24", stroke="currentColor")
            path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01")
          span Comanda
        // Enlaces adicionales dentro del sidebar
        ul
          li: a(href="/guia-mesero" , class="block py-2 hover:bg-gray-700") Guía de usuario
          li: a(href="#",id="frmC", class="block py-2 hover:bg-gray-700") Cerrar sesión
      // Bloque para el contenido principal
      section(class="flex-1 p-4")
        block contenido

    block scripts
