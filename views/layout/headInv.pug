doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Click-comanda | #{pagina}
    link(rel="stylesheet", href="/css/app.css")
    script.
        function toggleSidebar() {
          document.getElementById('leftSidebar').classList.toggle('hidden');
        }
    block styles
  body.min-h-screen.bg-gray-50
    // Header superior con el botón de menú (hamburguesa)
    header(class="flex justify-between items-center p-4 bg-white shadow border-b-4 border-blue-600")  
      // Botón de la izquierda para mostrar/ocultar el sidebar
      button(type="button", onclick="toggleSidebar()", class="p-2 focus:outline-none")
        svg(xmlns="http://www.w3.org/2000/svg", class="h-8 w-8 text-gray-700", fill="none", viewBox="0 0 24 24", stroke="currentColor")
          path(stroke-linecap="round", stroke-linejoin="round", stroke-width="2", d="M4 6h16M4 12h16M4 18h16")
      h1(class="text-xl font-bold absolute left-1/2 transform -translate-x-1/2") Click-comanda

    main(class="flex")
      aside#leftSidebar(class="w-64 bg-gray-800 text-white p-4 hidden")
        h2(class="text-xl mb-4") Click-comanda
        ul
            li: a(href="/nosotros", class="block py-2 hover:bg-gray-700") Acerca de nosotros
            li: a(href="/usuario/iniciar-sesion",id="frmC", class="block py-2 hover:bg-gray-700") Iniciar sesión

      section(class="flex-1 p-4")
        block contenido

    block scripts